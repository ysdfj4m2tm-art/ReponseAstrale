NEXT_PUBLIC_SITE_URL=https://reponseastrale.fr
APP_URL=https://reponseastrale.fr
NEXT_PUBLIC_FORM_ENABLED=true
NEXT_PUBLIC_PROCESSING_DELAY=24 à 48 heures
NEXT_PUBLIC_HIGH_DEMAND=false
NEXT_PUBLIC_HIGH_DEMAND_MESSAGE=Nous recevons actuellement un nombre exceptionnel de demandes. Le délai de traitement peut être temporairement prolongé.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
GEOCODING_PROVIDER=none
GEOCODING_API_KEY=

# Neon — pooled for application traffic, direct for migrations only
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Informatif uniquement : la réactivation reste bloquée en code jusqu’à SDK corrigé.
NEON_AUTH_SECURITY_REVIEW=blocked

# Stripe — test mode only until the legal readiness gate passes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_SUN=
STRIPE_PRICE_THREE_SUNS=
STRIPE_ENVIRONMENT=test
STRIPE_AUTOMATIC_TAX=false

# Server-to-server Studio bridge
STUDIO_API_TOKEN=

# Public support and future transactional email provider (server-side only)
PUBLIC_SUPPORT_EMAIL=contact@reponseastrale.fr
EMAIL_PROVIDER=resend
EMAIL_FROM=RéponseAstrale <contact@reponseastrale.fr>
RESEND_API_KEY=

# Google Gemini API (server-side only; never prefix these with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=
SENSITIVE_CONTENT_GUARD=block
